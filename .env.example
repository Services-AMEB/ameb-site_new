# URL publique du site (canonical, sitemap, OG). [À CONFIRMER : domaine]
SITE_URL=https://ameb.ca
# production | dev — « dev » (préproduction) : noindex sur toutes les pages, robots.txt « Disallow: / ».
SITE_ENV=production

# --- Variables publiques (exposées au navigateur) ---
# Clé de site Cloudflare Turnstile (pages avec formulaire seulement).
PUBLIC_TURNSTILE_SITEKEY=
# Script d'analytics sans témoins (Umami ou Plausible). Vide = aucun script, aucun événement.
PUBLIC_ANALYTICS_SRC=
# Identifiant du site pour Umami (data-website-id) ou domaine pour Plausible (data-domain).
PUBLIC_ANALYTICS_ID=
# Lien externe de prise de rendez-vous. [À CONFIRMER] Vide = renvoi vers la page Contact.
PUBLIC_BOOKING_URL=

# --- Secrets serveur (Cloudflare Pages Function /api/contact) ---
TURNSTILE_SECRET=
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
# Tests seulement : URL de vérification Turnstile simulée.
# TURNSTILE_VERIFY_URL=
