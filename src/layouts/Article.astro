---
/** Gabarit d'article de blogue (JSON-LD Article). */
import Page from './Page.astro';
import Button from '../components/Button.astro';
import { ROUTES, url, HTML_LANG, type Lang, type RouteKey } from '../i18n/routes';
import { t } from '../i18n/ui';
import { absolute, ogImagePath } from '../lib/seo';
import { formatDate } from '../lib/dates';

interface Props {
  lang: Lang;
  routeKey: RouteKey;
  title: string;
  description: string;
  h1: string;
  lead: string;
  date: Date;
  updated?: Date;
  readingMinutes: number;
}

const { lang, routeKey, title, description, h1, lead, date, updated, readingMinutes } = Astro.props;
const articleLd = {
  '@type': 'Article',
  headline: h1,
  description,
  inLanguage: HTML_LANG[lang],
  datePublished: date.toISOString().slice(0, 10),
  dateModified: (updated ?? date).toISOString().slice(0, 10),
  mainEntityOfPage: absolute(ROUTES[routeKey][lang], Astro.site),
  image: absolute(ogImagePath(routeKey, lang), Astro.site),
  author: { '@id': `${absolute('/', Astro.site)}#organization` },
  publisher: { '@id': `${absolute('/', Astro.site)}#organization` },
};
---

<Page
  lang={lang}
  routeKey={routeKey}
  title={title}
  description={description}
  h1={h1}
  lead={lead}
  ogType="article"
  crumbs={[{ label: t(lang, 'nav.ressources'), key: 'ressources' }, { label: h1 }]}
  jsonLd={[articleLd]}
>
  <p slot="head-extra" class="muted article-meta">
    {t(lang, 'common.published')} <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date, lang)}</time> · {readingMinutes} {t(lang, 'common.minutes')}
  </p>
  <article class="container section article">
    <div class="prose">
      <slot />
    </div>
    <aside class="article__aside callout" aria-label={t(lang, 'cta.quiz')}>
      <div class="stack">
        <p><strong>{t(lang, 'cta.quiz')}</strong></p>
        <Button href={url('outils/autoevaluation', lang)} variant="secondary" size="sm">{t(lang, 'cta.quiz')}</Button>
      </div>
    </aside>
  </article>
</Page>

<style>
  @layer components {
    .article {
      padding-block-start: 0;
      display: grid;
      gap: var(--sp-12);
    }

    .article__aside {
      grid-template-columns: 1fr;
    }

    .article-meta {
      font-size: var(--fs-sm);
    }
  }
</style>
