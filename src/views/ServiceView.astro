---
import Page from '../layouts/Page.astro';
import Card from '../components/Card.astro';
import CaseCard from '../components/CaseCard.astro';
import Steps from '../components/Steps.astro';
import FlowLine from '../components/FlowLine.astro';
import FAQ from '../components/FAQ.astro';
import { absolute, faqLd } from '../lib/seo';
import { ROUTES, type Lang, type RouteKey } from '../i18n/routes';
import { t } from '../i18n/ui';
import { getOne } from '../lib/content';

interface Props {
  lang: Lang;
  serviceKey: string;
}

const { lang, serviceKey } = Astro.props;
const routeKey = `services/${serviceKey}` as RouteKey;
const { data } = await getOne('services', serviceKey, lang);
const linkedCase = await getOne('cas', data.case, lang);
const serviceLd = {
  '@type': 'Service',
  name: data.name,
  description: data.description,
  serviceType: data.name,
  url: absolute(ROUTES[routeKey][lang], Astro.site),
  provider: { '@id': `${absolute('/', Astro.site)}#organization` },
  areaServed: { '@type': 'AdministrativeArea', name: 'Québec' },
};
---

<Page
  lang={lang}
  routeKey={routeKey}
  title={data.title}
  description={data.description}
  h1={data.h1}
  lead={data.lead}
  crumbs={[{ label: t(lang, 'nav.services'), key: 'services' }, { label: data.name }]}
  jsonLd={[serviceLd, faqLd(data.faq)]}
>
  <section class="section section--surface" aria-labelledby="h-pains">
    <div class="container">
      <div class="section__head"><h2 id="h-pains">{t(lang, 'service.pains')}</h2></div>
      <div class="cards cards--3">
        {data.pains.map((p) => <Card title={p.title} text={p.text} variant="white" />)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="h-capabilities">
    <div class="container">
      <div class="section__head"><h2 id="h-capabilities">{t(lang, 'service.capabilities')}</h2></div>
      <div class="cards cards--3">
        {data.capabilities.map((c) => <Card title={c.title} text={c.text} />)}
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="h-thread">
    <div class="container split">
      <div class="stack">
        <h2 id="h-thread">{t(lang, 'service.thread')}</h2>
        <p class="lead">{t(lang, 'service.threadText')}</p>
      </div>
      <FlowLine lang={lang} flow={data.flow} />
    </div>
  </section>

  <section class="section" aria-labelledby="h-steps">
    <div class="container">
      <div class="section__head"><h2 id="h-steps">{t(lang, 'service.steps')}</h2></div>
      <Steps lang={lang} texts={data.steps} />
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="h-case">
    <div class="container">
      <div class="section__head"><h2 id="h-case">{t(lang, 'service.case')}</h2></div>
      <div class="cards cards--2">
        <CaseCard entry={linkedCase} lang={lang} />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="h-faq">
    <div class="container">
      <div class="section__head"><h2 id="h-faq">{t(lang, 'service.faq')}</h2></div>
      <FAQ items={data.faq} />
    </div>
  </section>
</Page>
