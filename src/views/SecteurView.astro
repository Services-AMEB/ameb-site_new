---
import Page from '../layouts/Page.astro';
import Card from '../components/Card.astro';
import CaseCard from '../components/CaseCard.astro';
import FlowLine from '../components/FlowLine.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import Icon from '../components/Icon.astro';
import { url, type Lang, type RouteKey } from '../i18n/routes';
import { t } from '../i18n/ui';
import { getOne } from '../lib/content';

interface Props {
  lang: Lang;
  sectorKey: string;
}

const { lang, sectorKey } = Astro.props;
const routeKey = `secteurs/${sectorKey}` as RouteKey;
const { data } = await getOne('secteurs', sectorKey, lang);
const linkedCase = await getOne('cas', data.case, lang);
---

<Page
  lang={lang}
  routeKey={routeKey}
  title={data.title}
  description={data.description}
  h1={data.h1}
  lead={data.lead}
  crumbs={[{ label: t(lang, 'nav.secteurs'), key: 'secteurs' }, { label: data.name }]}
>
  <section class="section section--surface" aria-labelledby="h-realities">
    <div class="container">
      <div class="section__head"><h2 id="h-realities">{t(lang, 'sector.realities')}</h2></div>
      <ul class="cards cards--3" role="list">
        {data.realities.map((r) => <li class="card card--white reveal"><p class="realities__text">{r}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="h-flow">
    <div class="container split">
      <div class="stack">
        <h2 id="h-flow">{t(lang, 'sector.flow')}</h2>
        <p class="lead">{t(lang, 'service.threadText')}</p>
      </div>
      <FlowLine lang={lang} flow={data.flow} />
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="h-capabilities">
    <div class="container">
      <div class="section__head"><h2 id="h-capabilities">{t(lang, 'sector.capabilities')}</h2></div>
      <div class="cards cards--3">
        {
          data.capabilities.map((c) => (
            <Card
              title={c.title}
              text={c.text}
              href={url(`services/${c.service}` as RouteKey, lang)}
              more={t(lang, 'cta.learnMore')}
              variant="white"
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="h-case">
    <div class="container">
      <div class="section__head"><h2 id="h-case">{t(lang, 'sector.case')}</h2></div>
      <div class="cards cards--2">
        <CaseCard entry={linkedCase} lang={lang} />
      </div>
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="h-compliance">
    <div class="container">
      <div class="callout">
        <Icon name="shield-check" />
        <div>
          <h2 id="h-compliance">{data.compliance.title}</h2>
          <p>{data.compliance.text}</p>
          <p class="mt-8"><a class="link" href={url('confiance', lang)}>{t(lang, 'nav.confiance')}<Icon name="arrow-right" /></a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="h-ba">
    <div class="container">
      <div class="section__head"><h2 id="h-ba">{t(lang, 'sector.beforeAfter')}</h2></div>
      <BeforeAfter lang={lang} id={`ba-${sectorKey}`} />
    </div>
  </section>
</Page>

<style>
  @layer components {
    .realities__text {
      font-size: var(--fs-md);
      color: var(--color-text) !important;
    }
  }
</style>
