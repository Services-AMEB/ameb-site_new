---
import Page from '../layouts/Page.astro';
import Calculator from '../components/Calculator.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import { url, type Lang } from '../i18n/routes';
import { t } from '../i18n/ui';
import { getPage } from '../lib/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { data } = await getPage('calculateur', lang);
---

<Page
  lang={lang}
  routeKey="outils/calculateur-ressaisie"
  title={data.title}
  description={data.description}
  h1={data.h1}
  lead={data.lead}
  crumbs={[{ label: t(lang, 'nav.outils'), key: 'outils' }, { label: data.h1 }]}
>
  <section class="section section--surface" aria-label={data.h1}>
    <div class="container">
      <Calculator lang={lang} />
    </div>
  </section>

  <section class="section" aria-labelledby="h-howto">
    <div class="container split split--even">
      <div class="stack">
        <h2 id="h-howto">{data.howTo.h2}</h2>
        <ul class="checklist">
          {data.howTo.items.map((i) => <li><Icon name="info" /><span>{i}</span></li>)}
        </ul>
      </div>
      <div class="callout">
        <Icon name="route" />
        <div class="stack">
          <h2>{data.next.title}</h2>
          <p>{data.next.text}</p>
          <div class="cluster">
            <Button href={url('diagnostic', lang)} icon="arrow-right" track="cta_diagnostic" placement="calculator">{t(lang, 'cta.diagnostic')}</Button>
            <a class="link" href={url('outils/autoevaluation', lang)}>{t(lang, 'cta.quiz')}</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Page>
