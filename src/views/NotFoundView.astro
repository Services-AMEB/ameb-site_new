---
import Page from '../layouts/Page.astro';
import Button from '../components/Button.astro';
import { url, type Lang } from '../i18n/routes';
import { t } from '../i18n/ui';
import { getPage } from '../lib/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { data } = await getPage('404', lang);
---

<Page lang={lang} routeKey="404" title={data.title} description={data.description} h1={data.h1} lead={data.lead} noindex crumbs={[{ label: data.h1 }]}>
  <div class="container section cluster">
    <Button href={url('home', lang)}>{t(lang, 'nav.home')}</Button>
    <Button href={url('services', lang)} variant="secondary">{t(lang, 'nav.services')}</Button>
    <Button href={url('contact', lang)} variant="ghost">{t(lang, 'nav.contact')}</Button>
  </div>
</Page>
