---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SectionSilo from '../components/SectionSilo.astro';
import Card from '../components/Card.astro';
import CaseCard from '../components/CaseCard.astro';
import Steps from '../components/Steps.astro';
import FlowLine from '../components/FlowLine.astro';
import FinalCta from '../components/FinalCta.astro';
import Icon from '../components/Icon.astro';
import { url, type Lang, type RouteKey } from '../i18n/routes';
import { t } from '../i18n/ui';
import { getPage, keyOf, listEntries } from '../lib/content';
import { annualCost, formatMoney, CALC_LIMITS } from '../lib/calc';
import { organizationLd } from '../lib/seo';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { data } = await getPage('accueil', lang);
const services = await listEntries('services', lang);
const secteurs = await listEntries('secteurs', lang);
const cas = await listEntries('cas', lang);
const amount = formatMoney(
  annualCost({ employees: 1, hours: CALC_LIMITS.hours.default, rate: CALC_LIMITS.rate.default }),
  lang,
);
---

<Base lang={lang} routeKey="home" title={data.title} description={data.description} jsonLd={organizationLd(lang, Astro.site)}>
  <Hero lang={lang} h1={data.hero.h1} lead={data.hero.lead} proof={data.hero.proof} />

  <SectionSilo lang={lang} />

  <section class="section" aria-labelledby="h-pains">
    <div class="container">
      <div class="section__head"><h2 id="h-pains">{data.pains.h2}</h2></div>
      <div class="cards cards--4">
        {data.pains.items.map((p) => <Card title={p.title} text={p.text} icon={p.icon} />)}
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="h-cost">
    <div class="container cost">
      <h2 id="h-cost">{data.cost.h2}</h2>
      <p class="cost__sentence">
        {data.cost.before} <strong class="proof cost__amount">{amount}</strong> {data.cost.after}
      </p>
      <p class="cost__note">{data.cost.note}</p>
      <a class="link" href={url('outils/calculateur-ressaisie', lang)}>{data.cost.link}<Icon name="arrow-right" /></a>
    </div>
  </section>

  <section class="section" aria-labelledby="h-automate">
    <div class="container">
      <div class="section__head">
        <h2 id="h-automate">{data.automate.h2}</h2>
        <p>{data.automate.lead}</p>
      </div>
      <div class="cards cards--3">
        {
          services.map((s) => (
            <Card
              title={s.data.name}
              text={s.data.summary}
              icon={s.data.icon}
              href={url(`services/${keyOf(s)}` as RouteKey, lang)}
              more={t(lang, 'cta.learnMore')}
              variant="white"
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="h-sectors">
    <div class="container">
      <div class="section__head">
        <h2 id="h-sectors">{data.sectors.h2}</h2>
        <p>{data.sectors.lead}</p>
      </div>
      <div class="cards cards--3">
        {
          secteurs.map((s) => (
            <Card
              title={s.data.name}
              text={s.data.summary}
              href={url(`secteurs/${keyOf(s)}` as RouteKey, lang)}
              more={t(lang, 'cta.learnMore')}
              variant="white"
            >
              <FlowLine lang={lang} flow={s.data.flow} mini />
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="h-approach">
    <div class="container">
      <div class="section__head">
        <h2 id="h-approach">{data.approach.h2}</h2>
        <p>{data.approach.lead}</p>
      </div>
      <Steps lang={lang} texts={data.approach.steps} />
      <p class="mt-12"><a class="link" href={url('approche', lang)}>{t(lang, 'nav.approche')}<Icon name="arrow-right" /></a></p>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="h-agnostic">
    <div class="container split split--even">
      <div class="stack">
        <h2 id="h-agnostic">{data.agnostic.h2}</h2>
        <p class="lead">{data.agnostic.text}</p>
      </div>
      <ul class="checklist">
        {data.agnostic.points.map((p) => <li><Icon name="check" /><span>{p}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="h-cases">
    <div class="container">
      <div class="section__head">
        <h2 id="h-cases">{data.cases.h2}</h2>
        <p>{data.cases.lead}</p>
      </div>
      <div class="cards cards--3">
        {cas.map((c) => <CaseCard entry={c} lang={lang} />)}
      </div>
      <p class="mt-8"><a class="link" href={url('realisations', lang)}>{t(lang, 'cta.seeAllCases')}<Icon name="arrow-right" /></a></p>
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="h-trust">
    <div class="container">
      <div class="section__head"><h2 id="h-trust">{data.trust.h2}</h2></div>
      <ul class="cards cards--3 trust" role="list">
        {
          data.trust.items.map((item) => (
            <li class="card card--white trust__item reveal">
              <span class="icon-tile"><Icon name={item.icon} /></span>
              <p class="trust__text">{item.text}</p>
            </li>
          ))
        }
      </ul>
      <p class="mt-8"><a class="link" href={url('confiance', lang)}>{data.trust.link}<Icon name="arrow-right" /></a></p>
    </div>
  </section>

  <FinalCta lang={lang} placement="home-final" />
</Base>

<style>
  @layer components {
    .cost {
      display: grid;
      gap: var(--sp-4);
      justify-items: start;
    }

    .cost__sentence {
      font-size: var(--fs-lg);
      max-inline-size: 40ch;

      @media (min-width: 768px) {
        font-size: var(--fs-xl);
      }
    }

    .cost__amount {
      display: block;
      margin-block: var(--sp-2);
    }

    .cost__note {
      color: var(--color-text-2);
      display: flex;
      flex-wrap: wrap;
      gap: var(--sp-2);
      align-items: center;
    }

    .trust__text {
      font-family: var(--font-display);
      font-weight: var(--fw-semibold);
      font-size: var(--fs-lg);
      color: var(--color-text) !important;
    }
  }
</style>
