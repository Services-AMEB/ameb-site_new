---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Calc from '../components/home/Calc.astro';
import Gains from '../components/home/Gains.astro';
import Method from '../components/home/Method.astro';
import Services from '../components/home/Services.astro';
import Sectors from '../components/home/Sectors.astro';
import Offer from '../components/home/Offer.astro';
import CaseCards from '../components/CaseCards.astro';
import FAQ from '../components/FAQ.astro';
import FinalCta from '../components/FinalCta.astro';
import Icon from '../components/Icon.astro';
import { url, type Lang } from '../i18n/routes';
import { getPage, listEntries } from '../lib/content';
import { faqLd, organizationLd } from '../lib/seo';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { data } = await getPage('accueil', lang);
const cases = await listEntries('cas', lang);
---

<Base lang={lang} routeKey="home" title={data.title} description={data.description} jsonLd={[...organizationLd(lang, Astro.site), faqLd(data.faq)]}>
  <Hero lang={lang} hero={data.hero} panel={data.panel} />
  <Calc lang={lang} calc={data.calc} />
  <Gains lang={lang} gains={data.gains} />
  <Method lang={lang} method={data.method} />
  <Services services={data.services} />
  <Sectors sectors={data.sectors} />

  <section class="section section--surface" id="preuve" aria-labelledby="h-preuve">
    <div class="container">
      <div class="section__head">
        <span class="eyebrow">{data.proof.eyebrow}</span>
        <h2 id="h-preuve">{data.proof.h2}</h2>
        <p>{data.proof.lead}</p>
      </div>
      <CaseCards lang={lang} cases={cases} labels={{ before: data.proof.before, after: data.proof.after, changed: data.proof.changed }} />
      <p class="mt-8"><a class="link" href={url('realisations', lang)}>{data.proof.link}<Icon name="arrow-right" /></a></p>
    </div>
  </section>

  <Offer lang={lang} offer={data.offer} />

  <section class="section section--surface" aria-labelledby="h-faq">
    <div class="container">
      <div class="section__head"><h2 id="h-faq">{data.faqTitle}</h2></div>
      <FAQ items={data.faq} />
    </div>
  </section>

  <FinalCta lang={lang} placement="home-final" />
</Base>
