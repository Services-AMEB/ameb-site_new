---
import Page from '../layouts/Page.astro';
import Quiz from '../components/Quiz.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import { url, type Lang } from '../i18n/routes';
import { t } from '../i18n/ui';
import { getPage } from '../lib/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { data } = await getPage('autoevaluation', lang);
---

<Page
  lang={lang}
  routeKey="outils/autoevaluation"
  title={data.title}
  description={data.description}
  h1={data.h1}
  lead={data.lead}
  crumbs={[{ label: t(lang, 'nav.outils'), key: 'outils' }, { label: data.h1 }]}
>
  <section class="section section--surface" aria-labelledby="h-intro">
    <div class="container split split--even quiz-page">
      <div class="stack">
        <h2 id="h-intro">{data.intro.h2}</h2>
        <ul class="checklist">
          {data.intro.items.map((i) => <li><Icon name="check" /><span>{i}</span></li>)}
        </ul>
      </div>
      <Quiz lang={lang} />
    </div>
  </section>

  <section class="section" aria-labelledby="h-next">
    <div class="container">
      <div class="callout">
        <Icon name="route" />
        <div class="stack">
          <h2 id="h-next">{data.next.title}</h2>
          <p>{data.next.text}</p>
          <div class="cluster">
            <Button href={url('diagnostic', lang)} icon="arrow-right" track="cta_diagnostic" placement="quiz-page">{t(lang, 'cta.diagnostic')}</Button>
            <a class="link" href={url('outils/calculateur-ressaisie', lang)}>{t(lang, 'cta.calculator')}</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Page>

<style>
  @layer components {
    .quiz-page {
      align-items: start;
    }
  }
</style>
