---
/**
 * Calculateur du coût de la ressaisie (brief §5.5).
 * Sans JS : formulaire GET + formule et exemple en texte. Avec JS : calcul en direct,
 * état dans l'URL (partage), résultat annoncé (aria-live="polite").
 */
import Icon from './Icon.astro';
import { CALC_LIMITS, annualCost, formatMoney, WEEKS_PER_YEAR } from '../lib/calc';
import { url, type Lang } from '../i18n/routes';
import { t } from '../i18n/ui';
import { typo } from '../lib/typo';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = { employees: CALC_LIMITS.employees.default, hours: CALC_LIMITS.hours.default, rate: CALC_LIMITS.rate.default };
const example = formatMoney(annualCost(d), lang);
const sitekey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY?.trim() ?? '';
const fields = [
  { name: 'employees', label: t(lang, 'calc.employees'), lim: CALC_LIMITS.employees },
  { name: 'hours', label: t(lang, 'calc.hours'), lim: CALC_LIMITS.hours },
  { name: 'rate', label: t(lang, 'calc.rate'), lim: CALC_LIMITS.rate },
] as const;
const exampleText = typo(
  lang === 'fr'
    ? `Exemple : ${d.employees} employé × ${String(d.hours).replace('.', ',')} h × ${WEEKS_PER_YEAR} semaines × ${d.rate} $ = ${example}.`
    : `Example: ${d.employees} employee × ${d.hours} h × ${WEEKS_PER_YEAR} weeks × $${d.rate} = ${example}.`,
  lang,
);
---

<div class="calc" data-calc data-lang={lang}>
  <form class="calc__form" method="get" data-calc-form>
    <div class="calc__fields">
      {
        fields.map((f) => (
          <div class="field">
            <label for={`calc-${f.name}`}>{f.label}</label>
            <input
              class="input num"
              id={`calc-${f.name}`}
              name={f.name}
              type="number"
              inputmode="decimal"
              min={f.lim.min}
              max={f.lim.max}
              step={f.lim.step}
              value={f.lim.default}
              required
            />
            <p class="field__hint">
              {f.lim.min} – {f.lim.max}
            </p>
          </div>
        ))
      }
    </div>
    <button type="submit" class="btn btn--secondary calc__submit" data-calc-submit>{t(lang, 'calc.compute')}</button>
  </form>

  <div class="calc__result" aria-live="polite" aria-atomic="true" data-calc-result hidden>
    <p class="calc__label">{t(lang, 'calc.resultLabel')}</p>
    <p class="proof"><span data-calc-value>{example}</span> <span class="calc__unit">{t(lang, 'calc.perYear')}</span></p>
    <p class="badge">{t(lang, 'common.estimate')}</p>
  </div>

  <div class="calc__explain">
    <p><strong>{t(lang, 'calc.formula')}</strong></p>
    <p>{exampleText}</p>
    <p class="text-2">{t(lang, 'calc.disclaimer')}</p>
    <p class="text-2" data-calc-share hidden>{t(lang, 'calc.share')}</p>
  </div>

  <form class="calc__report" data-report-form data-sitekey={sitekey} data-lang={lang} data-generic-error={t(lang, 'form.error')} novalidate hidden>
    <h2 class="calc__report-title">{t(lang, 'calc.reportTitle')}</h2>
    <div class="field">
      <label for="report-email">{t(lang, 'form.email')}</label>
      <input class="input" id="report-email" name="email" type="email" autocomplete="email" inputmode="email" maxlength="254" data-rules="required email" data-error={t(lang, 'form.errors.email')} aria-describedby="report-email-error" />
      <p class="field__error" id="report-email-error" hidden><Icon name="circle-alert" /><span data-error-text></span></p>
    </div>
    <div class="field">
      <div class="checkbox">
        <input id="report-consent" name="consent" type="checkbox" data-rules="checked" data-error={t(lang, 'form.errors.consent')} aria-describedby="report-consent-error" />
        <label for="report-consent">{t(lang, 'calc.reportConsent')}</label>
      </div>
      <p class="field__error" id="report-consent-error" hidden><Icon name="circle-alert" /><span data-error-text></span></p>
    </div>
    <div class="visually-hidden" aria-hidden="true">
      <label for="report-website">Site web</label>
      <input id="report-website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <div data-turnstile></div>
    <div>
      <button type="submit" class="btn btn--primary" data-submit data-label={t(lang, 'calc.reportSubmit')} data-sending={t(lang, 'form.sending')}>{t(lang, 'calc.reportSubmit')}</button>
    </div>
    <div class="form-status form-status--success" role="status" data-status-success hidden>
      <Icon name="circle-check" /><span>{t(lang, 'calc.reportSuccess')}</span>
    </div>
    <div class="form-status form-status--error" role="alert" data-status-error hidden>
      <Icon name="circle-alert" /><span data-status-text></span>
    </div>
    <p class="form-privacy">
      {t(lang, 'form.privacy')} <a href={url('confidentialite', lang)}>{t(lang, 'form.privacyLink')}</a>.
    </p>
  </form>
</div>

<style>
  @layer components {
    .calc {
      display: grid;
      gap: var(--sp-8);
    }

    .calc__form {
      display: grid;
      gap: var(--sp-6);
      padding: var(--sp-8);
      background: var(--bg);
      border: var(--border-w) solid var(--line);
      border-radius: var(--radius-lg);
    }

    .calc__fields {
      display: grid;
      gap: var(--sp-6);

      @media (min-width: 768px) {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    .calc__submit {
      justify-self: start;
    }

    .calc__result {
      display: grid;
      gap: var(--sp-2);
      padding: var(--sp-8);
      border-radius: var(--radius-lg);
      background: var(--jade-050);
      border: var(--border-w) solid var(--jade-100);
    }

    .calc__result[hidden] {
      display: none;
    }

    .calc__label {
      font-weight: var(--fw-semibold);
      max-inline-size: var(--measure);
    }

    .calc__unit {
      font-size: var(--fs-lg);
      font-weight: var(--fw-semibold);
    }

    .calc__explain {
      display: grid;
      gap: var(--sp-3);
      max-inline-size: var(--measure);
    }

    .calc__report {
      display: grid;
      gap: var(--sp-4);
      max-inline-size: var(--measure);
      padding: var(--sp-8);
      background: var(--surface);
      border-radius: var(--radius-lg);
    }

    .calc__report[hidden] {
      display: none;
    }

    .calc__report-title {
      font-size: var(--fs-xl);
    }

  }
</style>

<script>
  import { annualCost, formatMoney, parseInput, type CalcInput } from '../lib/calc';
  import { postContact, setupTurnstile, validateField, wireValidation } from '../lib/forms';
  import { track } from '../lib/track';

  for (const root of document.querySelectorAll<HTMLElement>('[data-calc]')) {
    const lang = root.dataset.lang === 'en' ? 'en' : 'fr';
    const form = root.querySelector<HTMLFormElement>('[data-calc-form]');
    const result = root.querySelector<HTMLElement>('[data-calc-result]');
    const value = root.querySelector<HTMLElement>('[data-calc-value]');
    const share = root.querySelector<HTMLElement>('[data-calc-share]');
    const submit = root.querySelector<HTMLElement>('[data-calc-submit]');
    if (!form || !result || !value) continue;

    const input = (name: string) => form.querySelector<HTMLInputElement>(`[name="${name}"]`);
    const params = new URLSearchParams(location.search);
    let current: CalcInput = parseInput((k) => params.get(k));
    let tracked = false;

    const render = (fromUser: boolean) => {
      current = parseInput((k) => input(k)?.value);
      value.textContent = formatMoney(annualCost(current), lang);
      if (fromUser) {
        const q = new URLSearchParams({
          employees: String(current.employees),
          hours: String(current.hours),
          rate: String(current.rate),
        });
        history.replaceState(null, '', `${location.pathname}?${q}`);
        if (!tracked) {
          tracked = true;
          track('calc_complete');
        }
      }
    };

    for (const k of ['employees', 'hours', 'rate'] as const) {
      const el = input(k);
      if (el) el.value = String(current[k]);
      el?.addEventListener('input', () => render(true));
      el?.addEventListener('change', () => {
        // Normalise la valeur affichée (bornes et pas)
        if (el) el.value = String(parseInput((key) => input(key)?.value)[k]);
        render(true);
      });
    }
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      render(true);
    });
    if (submit) submit.hidden = true;
    result.hidden = false;
    if (share) share.hidden = false;
    render(false);

    // Rapport par courriel (optionnel, consentement explicite, case non cochée)
    const report = root.querySelector<HTMLFormElement>('[data-report-form]');
    if (!report) continue;
    report.hidden = false;
    const fields = wireValidation(report);
    const getToken = setupTurnstile(report, lang);
    const send = report.querySelector<HTMLButtonElement>('[data-submit]');
    const ok = report.querySelector<HTMLElement>('[data-status-success]');
    const ko = report.querySelector<HTMLElement>('[data-status-error]');
    report.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (ok) ok.hidden = true;
      if (ko) ko.hidden = true;
      const invalid = fields.filter((f) => !validateField(f));
      if (invalid.length) {
        invalid[0]?.focus();
        return;
      }
      if (send) {
        send.disabled = true;
        send.textContent = send.dataset.sending ?? '';
      }
      const email = report.querySelector<HTMLInputElement>('[name="email"]')?.value ?? '';
      const website = report.querySelector<HTMLInputElement>('[name="website"]')?.value ?? '';
      const token = await getToken();
      const res = await postContact({ kind: 'report', lang, email, consent: true, website, token, page: location.pathname, ...current });
      if (send) {
        send.disabled = false;
        send.textContent = send.dataset.label ?? '';
      }
      if (res.ok) {
        report.reset();
        if (ok) ok.hidden = false;
        track('report_request');
      } else if (ko) {
        const text = ko.querySelector('[data-status-text]');
        if (text) text.textContent = res.message ?? report.dataset.genericError ?? '';
        ko.hidden = false;
      }
      window.turnstile?.reset();
    });
  }
</script>
