---
/** Icônes métier des schémas (tableur, enveloppe, fiche, horloge, base de données, coche). À inclure une fois par page. */
---

<svg class="sprite" width="0" height="0" aria-hidden="true" focusable="false">
  <defs>
    <symbol id="ic-sheet" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
      <rect x="6" y="4" width="28" height="32" rx="3"></rect><path d="M6 13h28M6 22h28M6 31h28M16 4v32"></path>
    </symbol>
    <symbol id="ic-mail" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round">
      <rect x="4" y="9" width="32" height="22" rx="3"></rect><path d="m5 11 15 11 15-11"></path>
    </symbol>
    <symbol id="ic-card" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
      <rect x="4" y="6" width="32" height="28" rx="3"></rect><circle cx="13" cy="16" r="4"></circle><path d="M21 14h10M21 20h8M9 27h22"></path>
    </symbol>
    <symbol id="ic-clock" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
      <circle cx="20" cy="20" r="15"></circle><path d="M20 11v9l6 4"></path>
    </symbol>
    <symbol id="ic-db" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2.5">
      <ellipse cx="20" cy="9" rx="13" ry="5"></ellipse><path d="M7 9v22c0 3 6 5 13 5s13-2 13-5V9M7 20c0 3 6 5 13 5s13-2 13-5"></path>
    </symbol>
    <symbol id="ic-check" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="m10 20 7 7 13-14"></path>
    </symbol>
  </defs>
</svg>

<style>
  @layer components {
    .sprite {
      position: absolute;
      inline-size: 0;
      block-size: 0;
      overflow: hidden;
    }
  }
</style>
