---
/**
 * Concept C — « Avant / Avec ameb ». Un bouton (aria-pressed) bascule le même schéma :
 * nœuds dispersés et ardoise ↔ alignés et jade, liens tracés, tableau de bord visible.
 * View Transition si disponible, sinon FLIP (Web Animations API), 450 ms; mouvement réduit : fondu.
 */
import Icon from './Icon.astro';
import type { IconName } from './icons/lucide';
import type { Lang } from '../i18n/routes';
import { t, type UiKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  id?: string;
}

const { lang, id = 'ba' } = Astro.props;

const nodes: { key: UiKey; icon: IconName; before: [number, number, number]; after: [number, number] }[] = [
  { key: 'ba.nodes.crm', icon: 'users', before: [24, 16, -6], after: [17, 20] },
  { key: 'ba.nodes.billing', icon: 'receipt', before: [60, 28, 4], after: [17, 50] },
  { key: 'ba.nodes.mail', icon: 'mail', before: [14, 58, 3], after: [17, 80] },
  { key: 'ba.nodes.sheet', icon: 'sheet', before: [82, 12, -3], after: [83, 20] },
  { key: 'ba.nodes.agenda', icon: 'calendar-days', before: [72, 66, 5], after: [83, 50] },
  { key: 'ba.nodes.reports', icon: 'chart-column', before: [38, 84, -4], after: [83, 80] },
];
const hub = [50, 38];
---

<figure class="ba" data-ba aria-labelledby={`${id}-caption`}>
  <div class="ba__bar">
    <button type="button" class="ba__toggle" aria-pressed="false" data-ba-toggle hidden>
      <span class="ba__opt ba__opt--before">{t(lang, 'ba.before')}</span>
      <span class="ba__opt ba__opt--after">{t(lang, 'ba.after')}</span>
      <span class="visually-hidden">— {t(lang, 'ba.toggle')}</span>
    </button>
  </div>
  <div class="ba__scene">
    <svg class="ba__links" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      {
        nodes.map((n) => (
          <line
            x1={n.after[0]}
            y1={n.after[1]}
            x2={hub[0]}
            y2={hub[1]}
            vector-effect="non-scaling-stroke"
          />
        ))
      }
      <line x1={hub[0]} y1={hub[1]} x2="50" y2="76" vector-effect="non-scaling-stroke" />
    </svg>
    <div class="ba__hub" style={`--x: ${hub[0]}%; --y: ${hub[1]}%`} aria-hidden="true">
      <Icon name="database" />
      <span>{t(lang, 'ba.hub')}</span>
    </div>
    <div class="ba__dash" style="--x: 50%; --y: 78%" aria-hidden="true">
      <span class="ba__dash-title">{t(lang, 'ba.dashboard')}</span>
      <span class="ba__bars"><i></i><i></i><i></i><i></i></span>
    </div>
    <ul class="ba__nodes" role="list">
      {
        nodes.map((n, i) => (
          <li
            class="ba__node"
            data-ba-node={i}
            style={`--bx: ${n.before[0]}%; --by: ${n.before[1]}%; --br: ${n.before[2]}deg; --ax: ${n.after[0]}%; --ay: ${n.after[1]}%`}
          >
            <Icon name={n.icon} />
            <span>{t(lang, n.key)}</span>
          </li>
        ))
      }
    </ul>
  </div>
  <figcaption id={`${id}-caption`} class="ba__caption" aria-live="polite" data-before={t(lang, 'ba.descBefore')} data-after={t(lang, 'ba.descAfter')}>
    {t(lang, 'ba.descBefore')}
  </figcaption>
</figure>

<style>
  @layer components {
    .ba {
      display: grid;
      gap: var(--sp-4);
      padding: var(--sp-6);
      background: var(--bg);
      border: var(--border-w) solid var(--line);
      border-radius: var(--radius-lg);
    }

    .ba__bar {
      display: flex;
      justify-content: flex-start;
    }

    .ba__toggle {
      display: inline-flex;
      padding: var(--sp-1);
      border: var(--border-w) solid var(--slate-600);
      border-radius: var(--radius-round);
      background: var(--surface);
      min-block-size: var(--control-h);
      align-items: stretch;

      &[hidden] {
        display: none;
      }
    }

    .ba__opt {
      display: inline-flex;
      align-items: center;
      padding-inline: var(--sp-4);
      border-radius: var(--radius-round);
      font-family: var(--font-display);
      font-weight: var(--fw-semibold);
      font-size: var(--fs-sm);
      color: var(--color-text-2);
    }

    .ba__toggle[aria-pressed="false"] .ba__opt--before,
    .ba__toggle[aria-pressed="true"] .ba__opt--after {
      background: var(--jade-900);
      color: var(--white);
    }

    .ba__scene {
      position: relative;
      aspect-ratio: 1;
      border-radius: var(--radius-md);
      background: var(--surface);
      overflow: hidden;

      @media (min-width: 640px) {
        aspect-ratio: 16 / 10;
      }
    }

    .ba__links {
      position: absolute;
      inset: 0;
      inline-size: 100%;
      block-size: 100%;

      & line {
        stroke: var(--jade-600);
        stroke-width: 3;
        opacity: 0;
      }
    }

    .ba__nodes {
      position: absolute;
      inset: 0;
    }

    .ba__node {
      position: absolute;
      inset-inline-start: var(--bx);
      inset-block-start: var(--by);
      transform: translate(-50%, -50%) rotate(var(--br));
      display: inline-flex;
      align-items: center;
      gap: var(--sp-2);
      max-inline-size: 30%;
      padding: var(--sp-2) var(--sp-3);
      border: var(--focus-w) solid var(--slate-600);
      border-radius: var(--radius-md);
      background: var(--bg);
      color: var(--slate-700);
      font-size: var(--fs-sm);
      font-weight: var(--fw-semibold);
      line-height: var(--lh-tight);

      & svg {
        inline-size: var(--icon-sm);
        block-size: var(--icon-sm);
        flex: none;
      }
    }

    .ba__hub,
    .ba__dash {
      position: absolute;
      inset-inline-start: var(--x);
      inset-block-start: var(--y);
      transform: translate(-50%, -50%);
      display: grid;
      justify-items: center;
      gap: var(--sp-1);
      padding: var(--sp-3) var(--sp-4);
      border-radius: var(--radius-md);
      font-size: var(--fs-sm);
      font-weight: var(--fw-semibold);
      text-align: center;
      opacity: 0;
    }

    .ba__hub {
      background: var(--jade-900);
      color: var(--white);
      max-inline-size: 30%;
    }

    .ba__dash {
      background: var(--bg);
      border: var(--border-w) solid var(--jade-600);
      color: var(--jade-900);
    }

    .ba__bars {
      display: flex;
      align-items: end;
      gap: var(--sp-1);
      block-size: var(--sp-6);

      & i {
        display: block;
        inline-size: var(--sp-2);
        border-radius: var(--radius-sm);
        background: var(--jade-600);
      }

      & i:nth-child(1) {
        block-size: 40%;
      }

      & i:nth-child(2) {
        block-size: 65%;
      }

      & i:nth-child(3) {
        block-size: 55%;
      }

      & i:nth-child(4) {
        block-size: 100%;
      }
    }

    .ba__caption {
      color: var(--color-text-2);
      font-size: var(--fs-sm);
    }

    /* ---- État « Avec ameb » ---- */
    .ba.is-after {
      & .ba__node {
        inset-inline-start: var(--ax);
        inset-block-start: var(--ay);
        transform: translate(-50%, -50%);
        border-color: var(--jade-600);
        background: var(--jade-100);
        color: var(--jade-900);
      }

      & .ba__links line {
        opacity: 1;
      }

      & .ba__hub,
      & .ba__dash {
        opacity: 1;
      }
    }
  }

  @layer motion {
    @media (prefers-reduced-motion: no-preference) {
      .ba__links line {
        transition: opacity var(--dur-slow) var(--ease-out);
      }

      .ba__hub,
      .ba__dash {
        transition: opacity var(--dur-slow) var(--ease-out);
      }

      .ba__node {
        transition:
          background-color var(--dur-slow) var(--ease-out),
          border-color var(--dur-slow) var(--ease-out),
          color var(--dur-slow) var(--ease-out);
      }
    }

    :global(html.ba-vt)::view-transition-group(*) {
      animation-duration: var(--dur-slow);
      animation-timing-function: var(--ease-out);
    }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const SLOW = 450; // = --dur-slow (Web Animations API)
  const EASE = 'cubic-bezier(.2, 0, 0, 1)'; // = --ease-out

  for (const fig of document.querySelectorAll<HTMLElement>('[data-ba]')) {
    const button = fig.querySelector<HTMLButtonElement>('[data-ba-toggle]');
    const caption = fig.querySelector<HTMLElement>('.ba__caption');
    const nodes = [...fig.querySelectorAll<HTMLElement>('[data-ba-node]')];
    if (!button) continue;
    button.hidden = false;
    const uid = Math.random().toString(36).slice(2, 7);

    const apply = (after: boolean) => {
      fig.classList.toggle('is-after', after);
      button.setAttribute('aria-pressed', String(after));
      if (caption) caption.textContent = (after ? caption.dataset.after : caption.dataset.before) ?? '';
    };

    button.addEventListener('click', () => {
      const after = button.getAttribute('aria-pressed') !== 'true';
      const paused = document.documentElement.dataset.motion === 'paused';

      if (paused) return apply(after);

      if (reduce.matches) {
        apply(after);
        fig.querySelector('.ba__scene')?.animate([{ opacity: 0.4 }, { opacity: 1 }], { duration: 250, easing: EASE });
        return;
      }

      if (typeof document.startViewTransition === 'function') {
        nodes.forEach((n, i) => (n.style.viewTransitionName = `ba-${uid}-${i}`));
        document.documentElement.classList.add('ba-vt');
        const vt = document.startViewTransition(() => apply(after));
        vt.finished.finally(() => {
          nodes.forEach((n) => (n.style.viewTransitionName = ''));
          document.documentElement.classList.remove('ba-vt');
        });
        return;
      }

      // FLIP : First, Last, Invert, Play
      const first = nodes.map((n) => n.getBoundingClientRect());
      apply(after);
      nodes.forEach((n, i) => {
        const a = first[i];
        const b = n.getBoundingClientRect();
        if (!a) return;
        const dx = a.left + a.width / 2 - (b.left + b.width / 2);
        const dy = a.top + a.height / 2 - (b.top + b.height / 2);
        const end = getComputedStyle(n).transform;
        n.animate(
          [{ transform: `translate(${dx}px, ${dy}px) ${end === 'none' ? '' : end}` }, { transform: end }],
          { duration: SLOW, easing: EASE },
        );
      });
    });
  }
</script>
