---
/** Quatre étapes; ligne jade tracée au défilement (motion.css). */
import type { Lang } from '../i18n/routes';
import { t } from '../i18n/ui';
import { colon } from '../lib/typo';

interface Props {
  lang: Lang;
  /** Textes des étapes 1 à 4 (titres fixes : Diagnostic, Plan, Mise en place, Pilote automatique). */
  texts: string[];
  titles?: string[];
  level?: 'h3' | 'h4';
}

const { lang, texts, titles, level = 'h3' } = Astro.props;
const Heading = level;
const fixed = [t(lang, 'steps.1.title'), t(lang, 'steps.2.title'), t(lang, 'steps.3.title'), t(lang, 'steps.4.title')];
---

<div class="steps-wrap">
  <div class="steps__line" aria-hidden="true"></div>
  <ol class="steps" role="list">
    {
      texts.map((text, i) => (
        <li class="steps__item">
          <span class="steps__num" aria-hidden="true">{i + 1}</span>
          <Heading>
            <span class="visually-hidden">{t(lang, 'steps.label')} {i + 1}{colon(lang)} </span>
            {titles?.[i] ?? fixed[i]}
          </Heading>
          <p>{text}</p>
        </li>
      ))
    }
  </ol>
</div>
