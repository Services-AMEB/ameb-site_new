---
/** En-tête collant : logo, sections de l'accueil, pages, bascule clair/sombre, langue, CTA. Menu mobile en <dialog>. */
import Logo from './Logo.astro';
import LangSwitch from './LangSwitch.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
import { homeUrl, url, type HomeAnchor, type Lang, type RouteKey } from '../i18n/routes';
import { t, type UiKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  routeKey: RouteKey;
}

const { lang, routeKey } = Astro.props;

type Item = { href: string; label: UiKey; key?: RouteKey };
const anchors: { anchor: HomeAnchor; label: UiKey }[] = [
  { anchor: 'methode', label: 'nav.methode' },
  { anchor: 'services', label: 'nav.services' },
  { anchor: 'secteurs', label: 'nav.secteurs' },
];
const items: Item[] = [
  ...anchors.map((a) => ({ href: homeUrl(a.anchor, lang), label: a.label })),
  { href: url('realisations', lang), label: 'nav.realisations', key: 'realisations' },
  { href: url('diagnostic', lang), label: 'nav.diagnostic', key: 'diagnostic' },
  { href: url('contact', lang), label: 'nav.contact', key: 'contact' },
];
const current = (item: Item) => (item.key && routeKey === item.key ? 'page' : undefined);
---

<header class="site-header">
  <div class="container site-header__inner">
    <Logo lang={lang} height={26} />
    <nav class="site-nav" aria-label={t(lang, 'a11y.mainNav')}>
      <ul role="list" class="site-nav__list">
        {
          items.map((item) => (
            <li>
              <a href={item.href} class="site-nav__link" aria-current={current(item)}>
                {t(lang, item.label)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="site-header__actions">
      <button
        type="button"
        class="theme-toggle"
        data-theme-toggle
        aria-pressed="false"
        aria-label={t(lang, 'a11y.themeDark')}
        data-label-dark={t(lang, 'a11y.themeDark')}
        data-label-light={t(lang, 'a11y.themeLight')}
      >
        <span class="theme-toggle__sun"><Icon name="sun" /></span>
        <span class="theme-toggle__moon"><Icon name="moon" /></span>
      </button>
      <LangSwitch lang={lang} routeKey={routeKey} class="site-header__lang" />
      <Button href={url('diagnostic', lang)} size="sm" track="cta_diagnostic" placement="header" class="site-header__cta">
        {t(lang, 'cta.diagnostic')}
      </Button>
      <button type="button" class="menu-toggle" aria-haspopup="dialog" aria-controls="menu-mobile" data-menu-open>
        <Icon name="menu" />
        <span class="visually-hidden">{t(lang, 'a11y.openMenu')}</span>
      </button>
    </div>
  </div>

  <dialog class="menu" id="menu-mobile" aria-labelledby="menu-title">
    <div class="menu__head">
      <Logo lang={lang} height={24} />
      <h2 id="menu-title" class="visually-hidden">{t(lang, 'a11y.menuTitle')}</h2>
      <button type="button" class="menu-toggle" data-menu-close>
        <Icon name="x" />
        <span class="visually-hidden">{t(lang, 'a11y.closeMenu')}</span>
      </button>
    </div>
    <nav aria-label={t(lang, 'a11y.mobileNav')}>
      <ul role="list" class="menu__list">
        {
          items.map((item) => (
            <li>
              <a href={item.href} class="menu__link" aria-current={current(item)} data-menu-link>
                {t(lang, item.label)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="menu__foot">
      <Button href={url('diagnostic', lang)} track="cta_diagnostic" placement="menu">{t(lang, 'cta.diagnostic')}</Button>
      <LangSwitch lang={lang} routeKey={routeKey} />
    </div>
  </dialog>
</header>

<style>
  @layer components {
    .site-header {
      position: sticky;
      inset-block-start: 0;
      z-index: 50;
      background: var(--color-header-bg);
      backdrop-filter: blur(var(--sp-2));
      border-block-end: var(--border-w) solid var(--line);
      view-transition-name: header;
    }

    .site-header__inner {
      display: flex;
      align-items: center;
      gap: var(--sp-6);
      min-block-size: var(--header-h);
    }

    .site-nav {
      display: none;
      margin-inline-start: auto;

      @media (min-width: 1100px) {
        display: block;
      }
    }

    .site-nav__list {
      display: flex;
      gap: var(--sp-1);
    }

    .site-nav__link {
      display: inline-flex;
      align-items: center;
      min-block-size: var(--control-h);
      padding-inline: var(--sp-3);
      color: var(--color-text-2);
      font-weight: var(--fw-medium);
      font-size: var(--fs-sm);
      text-decoration: none;
      border-radius: var(--radius-sm);

      &:hover {
        color: var(--color-text);
        background: var(--surface);
      }

      &[aria-current] {
        color: var(--jade-900);
        text-decoration: underline;
        text-decoration-thickness: var(--focus-w);
        text-underline-offset: var(--sp-2);
      }
    }

    .site-header__actions {
      display: flex;
      align-items: center;
      gap: var(--sp-2);
      margin-inline-start: auto;

      @media (min-width: 1100px) {
        margin-inline-start: 0;
      }
    }

    .theme-toggle,
    .menu-toggle {
      display: inline-grid;
      place-items: center;
      inline-size: var(--sp-12);
      block-size: var(--sp-12);
      border: var(--border-w) solid var(--line);
      border-radius: var(--radius-sm);
      background: var(--bg);
      color: var(--color-text-2);

      &:hover {
        border-color: var(--jade-600);
        color: var(--color-text);
      }
    }

    .theme-toggle > span {
      display: inline-grid;
      grid-area: 1 / 1;
    }

    .theme-toggle__moon,
    :global(html[data-theme="dark"]) .theme-toggle__sun {
      display: none;
    }

    :global(html[data-theme="dark"]) .theme-toggle__moon {
      display: inline-grid;
    }

    .site-header__lang,
    .site-header__cta {
      display: none;

      @media (min-width: 640px) {
        display: inline-flex;
      }
    }

    .site-header__actions .menu-toggle {
      @media (min-width: 1100px) {
        display: none;
      }
    }

    .menu {
      inline-size: 100%;
      max-inline-size: 100%;
      block-size: 100%;
      max-block-size: 100%;
      margin: 0;
      padding: var(--sp-4);
      border: 0;
      background: var(--bg);
      color: var(--color-text);

      &::backdrop {
        background: var(--color-backdrop);
      }

      &[open] {
        display: grid;
        grid-template-rows: auto 1fr auto;
        gap: var(--sp-6);
      }
    }

    .menu__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .menu__list {
      display: grid;
      gap: var(--sp-1);
      align-content: start;
    }

    .menu__link {
      display: flex;
      align-items: center;
      min-block-size: var(--control-h);
      padding-inline: var(--sp-3);
      font-family: var(--font-display);
      font-size: var(--fs-lg);
      font-weight: var(--fw-semibold);
      color: var(--color-text);
      text-decoration: none;
      border-radius: var(--radius-sm);

      &[aria-current] {
        color: var(--jade-900);
        background: var(--jade-050);
      }
    }

    .menu__foot {
      display: grid;
      gap: var(--sp-3);
      justify-items: start;
    }
  }
</style>
