---
import { url, type Lang } from '../i18n/routes';
import { t } from '../i18n/ui';
import type { Crumb } from '../lib/seo';

interface Props {
  lang: Lang;
  crumbs: Crumb[];
}

const { lang, crumbs } = Astro.props;
---

<nav class="breadcrumb" aria-label={t(lang, 'a11y.breadcrumb')}>
  <ol>
    {
      crumbs.map((c, i) =>
        i === crumbs.length - 1 || !c.key ? (
          <li aria-current={i === crumbs.length - 1 ? 'page' : undefined}>{c.label}</li>
        ) : (
          <li>
            <a href={url(c.key, lang)}>{c.label}</a>
          </li>
        ),
      )
    }
  </ol>
</nav>
