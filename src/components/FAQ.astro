---
/** FAQ : <details> natifs (balisage FAQPage ajouté par la page via faqLd). */
import Icon from './Icon.astro';
import Txt from './Txt.astro';

interface Props {
  items: { q: string; a: string }[];
}

const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((item) => (
      <details>
        <summary>
          <span>{item.q}</span>
          <Icon name="chevron-right" />
        </summary>
        <div class="faq__answer">
          <p><Txt text={item.a} /></p>
        </div>
      </details>
    ))
  }
</div>
