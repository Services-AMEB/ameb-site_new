---
import ServiceView from '../../../views/ServiceView.astro';
import { childRoutes, slugOf } from '../../../i18n/routes';

export function getStaticPaths() {
  return childRoutes('services').map((key) => ({
    params: { slug: slugOf(key, 'en') },
    props: { key: key.slice('services/'.length) },
  }));
}

const { key } = Astro.props;
---

<ServiceView lang="en" serviceKey={key} />
