---
import CasView from '../../views/CasView.astro';
import { childRoutes, slugOf } from '../../i18n/routes';

export function getStaticPaths() {
  return childRoutes('realisations').map((key) => ({
    params: { slug: slugOf(key, 'fr') },
    props: { key: key.slice('realisations/'.length) },
  }));
}

const { key } = Astro.props;
---

<CasView lang="fr" caseKey={key} />
