---
import ArticleView from '../../views/ArticleView.astro';
import { childRoutes, slugOf } from '../../i18n/routes';

export function getStaticPaths() {
  return childRoutes('ressources').map((key) => ({
    params: { slug: slugOf(key, 'fr') },
    props: { key: key.slice('ressources/'.length) },
  }));
}

const { key } = Astro.props;
---

<ArticleView lang="fr" articleKey={key} />
